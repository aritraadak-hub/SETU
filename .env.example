# ==========================================
# BACKEND WEB SERVICE ENVIRONMENT VARIABLES
# (Set these in Render Web Service Dashboard)
# ==========================================

NODE_ENV=production
PORT=5000

# Backend URL & Frontend CORS
BACKEND_URL=https://setu-api.onrender.com
FRONTEND_URL=https://setu-web.onrender.com

# Database URL
# For local SQLite development:
# DATABASE_URL="file:./dev.db"
# For Render PostgreSQL production (provided by Render PostgreSQL):
DATABASE_URL="postgresql://username:password@hostname:5432/databasename"

# JWT Authentication (generate a secure random 32+ char secret)
JWT_SECRET=setu_bihar_tourism_jwt_super_secret_key_2026

# Razorpay Credentials (from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_setu_bihar_demo_key
RAZORPAY_KEY_SECRET=rzp_test_secret_demo_key_12345
RAZORPAY_SETU_PLUS_PLAN_ID=plan_demo_optional

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# FRONTEND STATIC SITE ENVIRONMENT VARIABLES
# (Set these in Render Static Site Dashboard)
# ==========================================

# Base URL to the backend API (must include /api)
VITE_API_URL=https://setu-api.onrender.com/api

# Public Razorpay key for client-side checkout
VITE_RAZORPAY_KEY_ID=rzp_test_setu_bihar_demo_key
