generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  passwordHash  String
  role          String  @default("TOURIST") // TOURIST, VENDOR, ADMIN
  avatar        String?
  phone         String?
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  // SETU Plus (customer premium membership)
  isPremium              Boolean   @default(false)
  premiumSince           DateTime?
  premiumExpiresAt       DateTime?
  razorpaySubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor        Vendor?
  orders        Order[]
  favorites     Favorite[]
  conversations Conversation[]
}

model Vendor {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description  String
  businessType String
  phone        String
  email        String
  address      String
  city         String
  district     String
  latitude     Float?
  longitude    Float?
  logo         String?
  coverImage   String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offerings     Offering[]
  orders        Order[]
  notifications Notification[]
  conversations Conversation[]
}

model Circuit {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  heroImage   String
  gallery     String   @default("[]") // JSON stringified array of image URLs
  overview    String
  locations   String   @default("[]") // JSON stringified array of locations
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations Destination[]
}

model District {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  region      String
  description String
  heroImage   String
  gallery     String   @default("[]") // JSON stringified array of image URLs
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations Destination[]
}

model Destination {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String
  districtId        String
  district          District @relation(fields: [districtId], references: [id])
  circuitId         String?
  circuit           Circuit? @relation(fields: [circuitId], references: [id])
  category          String
  heroImage         String
  gallery           String   @default("[]") // JSON stringified array of image URLs
  latitude          Float
  longitude         Float
  overview          String
  travelInformation String   @default("{}") // JSON stringified object
  stays             String   @default("[]") // JSON stringified array
  recommendations   String   @default("[]") // JSON stringified array
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  favorites Favorite[]
}

model Event {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  category          String // Festival, Fair, Cultural, Seasonal, Religious, Arts
  description       String
  startDate         DateTime
  endDate           DateTime
  year              Int      @default(2026)
  lastVerified      String   @default("2026-08-20")
  isLunar           Boolean  @default(false)
  location          String
  district          String
  latitude          Float
  longitude         Float
  heroImage         String
  gallery           String   @default("[]")
  nearestPolice     String?
  nearestHospital   String?
  nearbyRestaurants String?  @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  favorites Favorite[]
}

model CuisineItem {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  heroImage   String
  location    String
  district    String
  restaurants String   @default("[]") // JSON stringified array of {name, address, type}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Offering {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  description String
  category    String
  price       Float
  duration    String
  maxGuests   Int      @default(10)
  location    String
  latitude    Float?
  longitude   Float?
  coverImage  String
  gallery     String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id                String   @id @default(uuid())
  orderNumber       String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  offeringId        String
  offering          Offering @relation(fields: [offeringId], references: [id])
  quantity          Int      @default(1)
  bookingDate       DateTime
  amount            Float
  commissionAmount  Float    @default(0) // 7% SETU commission, set on successful payment verification
  vendorEarnings    Float    @default(0) // amount - commissionAmount, set on successful payment verification
  currency          String   @default("INR")
  paymentStatus     String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus       String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, COMPLETED, CANCELLED, REJECTED
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Favorite {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([userId, destinationId])
  @@unique([userId, eventId])
}

model CityHub {
  id                    String   @id @default(uuid())
  name                  String   @unique
  slug                  String   @unique
  region                String
  latitude              Float
  longitude             Float
  heroImage             String
  summary               String
  overallScore          Float
  tourismRating         Float
  hospitalRating        Float
  hotelRating           Float
  businessRating        Float
  educationRating       Float
  infrastructureRating  Float
  touristPlaces         String   @default("[]") // JSON array of {name, type}
  verdict               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Notification {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type           String   // booking_new, booking_cancelled, review_new, payment_credited, offering_approved, offering_rejected
  title          String
  message        String
  relatedOrderId String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Conversation {
  id            String   @id @default(uuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  touristUserId String
  touristUser   User     @relation(fields: [touristUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([vendorId, touristUserId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

